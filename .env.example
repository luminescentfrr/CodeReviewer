# CodeReview AI — 环境变量配置
# 复制此文件为 .env 并填写实际值

# ── 必需：至少配置一个 LLM ────────────────────────────────

# DeepSeek（推荐，成本最低）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（备用，DeepSeek 未配置时自动回退）
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o

# ── 可选 ──────────────────────────────────────────────────

# 服务器配置
# HOST=127.0.0.1
# PORT=8765

# API 认证密钥（不设置则仅允许 localhost 访问）
# APP_API_KEY=your-secret-key

# 每日 LLM 令牌配额
# DAILY_TOKEN_LIMIT=1000000

# 工作区根目录（默认当前目录）
# WORKSPACE_ROOT=.
